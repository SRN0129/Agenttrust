{
  "name": "@srn0129/agenttrust",
  "version": "1.0.0",
  "type": "module",
  "description": "Zero-trust policy enforcement, cryptographic audit ledger, and human-in-the-loop governance for autonomous agent runtimes",
  "repository": {
    "type": "git",
    "url": "https://github.com/SRN0129/Agenttrust.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "server": "tsx watch server/index.ts",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx server/db/seed.ts",
    "simulate": "tsx simulator/run_demo.ts",
    "git:commit": "tsx scripts/git_manager.ts",
    "git:push": "tsx scripts/push_to_github.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "isomorphic-git": "^1.44.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
